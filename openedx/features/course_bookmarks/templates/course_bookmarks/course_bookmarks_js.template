<%!
from openedx.core.djangolib.js_utils import dump_js_escaped_json, js_escaped_string
%>

(function (require, define) {
    require([
        'course_bookmarks/js/course_bookmarks_factory',
        'course_bookmarks/js/views/course_tabs_navigation'
    ], function (CourseBookmarksFactory, CourseTabsNavigation) {
        var courseId = '${str(course.id) | n, js_escaped_string}';
        
        // Initialize bookmarks
        CourseBookmarksFactory({
            $el: $(".course-bookmarks"),
            courseId: courseId,
            bookmarksApiUrl: '${bookmarks_api_url | n, js_escaped_string}',
        });
        
        // Initialize course tabs navigation
        new CourseTabsNavigation({
            courseId: courseId,
            $container: $('#course-tabs-navigation-container')
        });
    });
}).call(this, require || RequireJS.require, define || RequireJS.define);
